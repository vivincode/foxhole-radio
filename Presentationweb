// conceptual I-V sketch
function fit(c){const r=devicePixelRatio||1,w=c.clientWidth,h=+c.getAttribute("height");c.width=w*r;c.height=h*r;const x=c.getContext("2d");x.setTransform(r,0,0,r,0,0);return[x,w,h]}
function drawIV(){const[x,w,h]=fit($("iv"));x.strokeStyle="#445";x.beginPath();x.moveTo(0,h/2);x.lineTo(w,h/2);x.moveTo(w/2,0);x.lineTo(w/2,h);x.stroke();
 x.strokeStyle="#3aa0ff";x.lineWidth=2;x.beginPath();const k=kBase();for(let i=0;i<=200;i++){const v=(i/200)*2-1,c=.5*v*(1+k*Math.tanh(4*v));const px=w/2+v*w*.45,py=h/2-c*h*.9;i?x.lineTo(px,py):x.moveTo(px,py)}x.stroke();
 x.fillStyle="#8a96a6";x.font="11px sans-serif";x.fillText("voltage →",w-62,h/2-4);x.fillText("current",w/2+4,12)}
// ---------- oscilloscope ----------
const sc=$("sc");
function scope(){requestAnimationFrame(scope);const[x,w,h]=fit(sc);const rows=4,rh=h/rows;
 if(!S.paused){S.ph+=.05;S.jit=.7*S.jit+.3*(Math.random()*2-1)}
 const A=S.sg/100*match(),k=kNow(),m=.8,names=["1  RF carrier (unmodulated)","2  AM carrier (envelope = audio)","3  Detector output + recovered envelope","4  Final audio (DC removed)"];
 x.font="12px sans-serif";
 for(let r=0;r<rows;r++){const cy=rh*(r+.5);x.strokeStyle="#12202f";x.lineWidth=1;x.beginPath();x.moveTo(0,cy);x.lineTo(w,cy);x.stroke();x.fillStyle="#8a96a6";x.fillText(names[r],6,rh*r+14);}
 const amp=rh*.38;
 const tr=(r,fn,col,lw)=>{x.strokeStyle=col;x.lineWidth=lw;x.beginPath();const cy=rh*(r+.5);for(let i=0;i<=w;i+=1){const t=i/w,y=fn(t);i?x.lineTo(i,cy-y*amp):x.moveTo(i,cy-y*amp)}x.stroke()};
 const aud=t=>Math.sin(2*Math.PI*3*t-S.ph*.6), car=t=>Math.sin(2*Math.PI*45*t-S.ph*3), env=t=>(1+m*aud(t))/(1+m), am=t=>A*env(t)*car(t);
 tr(0,t=>A*car(t),"#9fc8ff",1.2);
 tr(1,am,"#fff",1.2);tr(1,t=>A*env(t),"rgba(58,160,255,.5)",1);
 tr(2,t=>{const v=am(t);return v>0?v:v*(1-k)},"rgba(255,255,255,.35)",1);tr(2,t=>k*A*env(t)*.9,"#3aa0ff",2.5);
 tr(3,t=>k*A*m/(1+m)*aud(t)*1.6,"#fff",2);
 const lvl=k*A;x.fillStyle="#3aa0ff";x.fillText("recovered audio level ≈ "+(lvl*100).toFixed(0)+"% of full scale (model)",w-250,rh*3+14);
 if(A<.05){x.fillStyle="#ff9b9b";x.fillText("Off-tune or too weak: almost nothing to detect",w/2-130,rh*.5)}
 // audio waveform preview
 let d="";for(let i=0;i<=400;i+=4)d+=(i?"L":"M")+i+" "+(30-Math.sin(i/400*2*Math.PI*6)*26*clamp(lvl*2+.05,.05,1));$("aw").setAttribute("d",d);}
