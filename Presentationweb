<script>
// ---------- helpers ----------
const $=id=>document.getElementById(id);
const clamp=(v,a,b)=>Math.min(b,Math.max(a,v));
// ---------- component data ----------
const P=[
{n:"Antenna wire",f:"Intercepts the radio wave and turns its electric field into a tiny RF voltage.",p:"Radio waves push charges along a conductor; a longer, higher, clear wire intercepts more signal.",b:"Long insulated wire strung outdoors or along a window, kept away from mains wiring.",m:"No antenna: almost no signal. Poor placement or short wire: weak, changing reception.",x:"Loose joints, short or screened by metal, touching other conductors."},
{n:"Tuning coil (inductor)",f:"Forms the inductance L of the tuned circuit.",p:"Together with capacitance C it resonates at f₀ = 1/(2π√LC), favouring one frequency.",b:"Insulated copper wire wound on a tube or former; turns set L.",m:"No coil: no selectivity, strong stations overlap.",x:"Loose turns, high resistance wire, bad solder, losses lower Q."},
{n:"Variable capacitor",f:"Changes C to move the resonant frequency across stations.",p:"Overlapping plates; more overlap gives more C and lowers f₀.",b:"Air-spaced tuning capacitor (or fixed capacitor plus tapped coil).",m:"Fixed tuning only; you may never land on a station.",x:"Dirty or bent plates, shorted plates, noisy sliding contact."},
{n:"Razor blade",f:"One side of the experimental detector contact.",p:"A metal surface (oxide, coating, steel alloy) touching graphite may behave nonlinearly at some points; unreliable.",b:"Steel blade; coating, rust and oxide change behavior.",m:"No detector: the RF cannot be demodulated; earphone stays silent.",x:"Wrong blade, coating, corrosion, dirt, unstable pressure."},
{n:"Graphite pencil",f:"Other side of the contact; a light movable probe.",p:"Graphite touches the blade at a tiny point; contact resistance and nonlinearity depend on the exact spot and pressure.",b:"Graphite lead, sharpened, held by a light spring or clip.",m:"No probe: no detector contact.",x:"Too heavy or loose pressure, vibration, blunt lead, dirty surface."},
{n:"High-impedance earphone",f:"Turns the tiny audio current into sound.",p:"A sensitive crystal or high-impedance (kΩ range) transducer gives usable sound from microwatts.",b:"Crystal earpiece or high-impedance magnetic headphone.",m:"No earphone: no output. Low-impedance buds: very faint or silent.",x:"Low impedance modern earbuds, powered devices, broken leads."},
{n:"Ground / return connection",f:"Provides the reference/return path for the RF current.",p:"The antenna current needs a path back; the ground or counterpoise completes the circuit.",b:"Safe approved earth reference or counterpoise wire; never mains.",m:"Poor return: weak or erratic signal.",x:"Poor contact, using unsafe earth, long resistive lead."},
{n:"Connecting wires",f:"Link all components with low resistance.",p:"Good joints keep losses low; clean contacts matter because signals are tiny.",b:"Short solid copper wire; soldered or clamped joints.",m:"Open or loose wire: circuit broken.",x:"Intermittent joints, corrosion, long routes adding stray capacitance."}];
// circuit info + cards
const info=$("info");
function show(k){const d=P[k];info.innerHTML=`<h3>${d.n}</h3><p><b>Function:</b> ${d.f}</p><p><b>Working principle:</b> ${d.p}</p><p><b>Construction:</b> ${d.b}</p><p><b>If missing/poorly connected:</b> ${d.m}</p>`;
 document.querySelectorAll("#cs .part").forEach(g=>g.classList.toggle("on",g.dataset.k==k));}
document.querySelectorAll("#cs .part").forEach(g=>{g.tabIndex=0;g.onclick=()=>show(g.dataset.k);g.onkeydown=e=>{if(e.key=="Enter")show(g.dataset.k)}});
$("pc").innerHTML=P.map(d=>`<div class="card"><h3>${d.n}</h3><p><b>Purpose:</b> ${d.f}</p><p><b>Principle:</b> ${d.p}</p><p><b>Failure modes:</b> ${d.x}</p></div>`).join("");
// signal particles along the loop path (SVG animateMotion)
(function(){const g=$("parts-dots");for(let i=0;i<8;i++)g.insertAdjacentHTML("beforeend",`<circle r="3.5"><animateMotion dur="6s" begin="${-i*.75}s" repeatCount="indefinite"><mpath href="#loop"/></animateMotion></circle>`)})();
let flow=true;$("flowbtn").onclick=()=>{const s=$("cs");flow?s.pauseAnimations():s.unpauseAnimations();flow=!flow;$("flowbtn").textContent=flow?"Pause signal flow":"Resume signal flow"};
// ---------- simulation state ----------
const S={fs:1000,L:250,C:101,sg:70,cq:80,paused:false,ph:0,jit:0};
const f0calc=()=>1/(2*Math.PI*Math.sqrt(S.L*1e-6*S.C*1e-12))/1e3; // kHz
const match=()=>Math.exp(-Math.pow((f0calc()-S.fs)/(S.fs*.04),2)); // simplified resonance curve (assumed Q)
const kBase=()=>.05+.85*S.cq/100;
function kNow(){const s=S.cq/100;const unst=s>.33&&s<.66?.25:0;return clamp(kBase()+unst*S.jit,0,1)}
function ui(){$("fsv").textContent=S.fs+" kHz";$("Lv").textContent=S.L+" µH";$("Cv").textContent=S.C+" pF";
 $("f0").textContent="f₀ = 1/(2π√LC) = "+f0calc().toFixed(0)+" kHz  (L="+S.L+" µH, C="+S.C+" pF)";
 $("mt").textContent=(match()*100).toFixed(0)+"% (station "+S.fs+" kHz)";$("sgv").textContent=S.sg+"%";
 const s=S.cq,t=s<33?"Poor contact":s<66?"Unstable contact":"Better contact";$("cqv").textContent=t;
 $("pen").style.transform=`translateY(${(100-s)*.02*-1+(s<66?0:2)}px)`;$("tip").setAttribute("opacity",.2+.8*s/100);
 $("fs").value=S.fs;$("dial").value=S.fs;$("L").value=S.L;$("C").value=S.C;drawIV();}
function setFs(v){S.fs=+v;const o=[...$("st").options].find(x=>x.value==v);$("st").value=o?v:"700";ui()}
$("fs").oninput=e=>setFs(e.target.value);$("dial").oninput=e=>setFs(e.target.value);
$("st").onchange=e=>setFs(e.target.value);
$("L").oninput=e=>{S.L=+e.target.value;ui()};$("C").oninput=e=>{S.C=+e.target.value;ui()};
$("sg").oninput=e=>{S.sg=+e.target.value;ui()};$("cq").oninput=e=>{S.cq=+e.target.value;ui()};
$("res").onclick=()=>{S.C=Math.round(clamp(1/Math.pow(2*Math.PI*S.fs*1e3,2)/(S.L*1e-6)*1e12,20,500));ui()};
$("pz").onclick=()=>{S.paused=!S.paused;$("pz").textContent=S.paused?"Resume":"Pause"};
function resetAll(){Object.assign(S,{fs:1000,L:250,C:101,sg:70,cq:80,paused:false,ph:0});$("pz").textContent="Pause";$("st").value=1000;ui()}
